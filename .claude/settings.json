{
  "permissions": {
    "allow": [
      "mcp__context7__query-docs",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(gh auth:*)",
      "Bash(gh secret:*)",
      "Bash(gh repo:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(appsettings.Development.json)",
      "Read(./appsettings.Production.json)",
      "Read(./**/*.pfx)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/scripts/block-secrets.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/scripts/format-on-write.ps1\""
          }
        ]
      }
    ]
  }
}
